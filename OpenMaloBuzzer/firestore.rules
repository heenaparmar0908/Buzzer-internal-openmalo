rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All operations require Firebase Auth (anonymous or otherwise)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users — profile info visible to all authenticated users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.keys()
          .hasAll(['name', 'phone', 'pin_hash', 'role', 'last_seen_at', 'is_active'])
        && request.resource.data.role in ['owner', 'manager', 'member']
        && request.resource.data.is_active == true;
      allow update: if isAuthenticated();
      allow delete: if false; // soft-delete only (is_active = false)
    }

    // FCM tokens — stored separately so other users cannot read them
    match /user_tokens/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Buzzes — core messaging documents
    match /buzzes/{buzzId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.keys()
          .hasAll(['from_user_id', 'to_user_id', 'reason', 'created_at', 'response'])
        && request.resource.data.response == 'none';
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Reasons — buzz reason labels
    match /reasons/{reasonId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // Groups
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.keys()
          .hasAll(['name', 'member_ids', 'created_by', 'created_at', 'is_active'])
        && request.resource.data.member_ids.size() >= 2
        && request.resource.data.is_active == true;
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Call Logs
    match /call_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.keys()
          .hasAll(['caller_id', 'receiver_id', 'started_at', 'duration_seconds']);
      allow update, delete: if false;
    }

    // Voice Mails
    match /voice_mails/{mailId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.keys()
          .hasAll(['from_user_id', 'to_user_id', 'audio_url', 'duration_seconds', 'created_at', 'listened']);
      allow update: if isAuthenticated();
      allow delete: if false;
    }

    // Settings
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
